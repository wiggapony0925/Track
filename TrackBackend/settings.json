{
  "app_settings": {
    "search_radius_meters": 8047,
    "refresh_interval_seconds": 20,
    "refresh_cooldown_seconds": 20,
    "nearest_metro_fallback_radius_meters": 5000,
    "max_nearby_results": 40,
    "max_arrivals_per_feed": 10,
    "nearby_bus_stops_limit": 10,
    "http_timeout_seconds": 15.0,
    "http_connect_timeout_seconds": 10.0,
    "http_max_retries": 2,
    "http_retry_delay_seconds": 1.0,
    "show_ghost_trains": false,
    "simulation_easing_enabled": true,
    "max_arrival_minutes": 120,
    "max_arrivals_per_line": 400,
    "placeholder_minutes": 99,
    "max_schedule_per_dormant": 10,
    "nearby_compute_timeout_seconds": 50,
    "docs_session_days": 7
