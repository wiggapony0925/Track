# MTA API Keys (if different from settings.json)
# MTA_API_KEY=your_mta_key
# MTA_BUS_KEY=your_bus_key

# ── ML Feature Flag ────────────────────────────────────────────────────────
# Controls whether the LightGBM arrival-prediction model adjusts displayed ETAs.
# Set to "false" to instantly bypass the ML model in production without a deploy.
# Valid off values: false | 0 | off | no | disabled  (anything else = ENABLED)
# Default when unset: true (ML is ON)
ARRIVING_PREDICTION_MODEL=true

# ── Docs Access Control ───────────────────────────────────────────────────
# Set a secret token to make API docs private. When set, visitors must use:
#   /api-docs?token=YOUR_TOKEN
# A session cookie is set on first valid visit (7 days), so the token only
# needs to be in the URL once per browser.
# Leave empty or unset for open access (local development).
# DOCS_ACCESS_TOKEN=some-random-secret-here

# ── Redis Connection Pool ──────────────────────────────────────────────────
# Max concurrent Redis connections.  Must stay below your Render Redis plan's
# maxclients limit.  Free/Starter: use 10-20.  Standard+: can go up to 50.
# Default: 20
# REDIS_MAX_CONNECTIONS=30  # Starter plan: 250 max connections; 30 is safe with WEB_CONCURRENCY=1
# How often (in seconds) the background task checks for new GTFS data.
# Default: 86400 (24 hours)
# GTFS_CHECK_INTERVAL=86400

# ── MetroMind (AI Chat Assistant) ────────────────────────────────────────
# OpenAI API key powering the MetroMind chat feature. Required when the
# chat is enabled; otherwise /metromind/chat returns 503.
# OPENAI_API_KEY=sk-...
#
# Tunables (all optional — defaults in app/metromind/config.py):
# METROMIND_MODEL=gpt-4o-mini
# METROMIND_TEMPERATURE=0.3
# METROMIND_MAX_OUTPUT_TOKENS=800
# METROMIND_MAX_TOOL_ITERATIONS=4
# METROMIND_STREAMING_ENABLED=true
# METROMIND_ENABLED=true   # Master kill switch
