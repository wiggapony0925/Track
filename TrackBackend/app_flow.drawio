        <mxCell id="n_l1" value="&lt;b style=&quot;font-size:12px;&quot;&gt;💾 L1 LRU Cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FEE2E2;&quot;&gt;512 entries · in-process OrderedDict&lt;br&gt;TTL 1h · zero-latency same instance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#DC2626;fontColor=#FFFFFF;strokeColor=#B91C1C;shadow=1;fontSize=11;" vertex="1" parent="1">
