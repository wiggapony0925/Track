        <mxCell id="title_main" value="&lt;b style=&quot;font-size:26px;color:#0F172A;&quot;&gt;Track App — Full Connection &amp;amp; ML Flow&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="700" y="18" width="950" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="title_sub" value="&lt;font style=&quot;font-size:12px;color:#64748B;&quot;&gt;n8n-style pipeline · iPhone → FastAPI (Render) → MTA · ML · Supabase · Live Activity&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="1">
