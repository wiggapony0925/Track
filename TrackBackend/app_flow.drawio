        <mxCell id="n_mta_feeds" value="&lt;b style=&quot;font-size:12px;&quot;&gt;🔄 10× MTA Feeds&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FEF3C7;&quot;&gt;GTFS-RT Protobuf (8 subway + LIRR + MNR)&lt;br&gt;JSON Alerts · Elevators · SIRI Bus · OBA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#D97706;fontColor=#FFFFFF;strokeColor=#B45309;shadow=1;fontSize=11;" vertex="1" parent="1">
