          <mxGeometry x="695" y="805" width="240" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="n_recency" value="&lt;b style=&quot;font-size:12px;&quot;&gt;📡 Redis EWMA Recency&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#D1FAE5;&quot;&gt;get_weighted_error()&lt;br&gt;per-stop bias: exp decay α=0.5&lt;br&gt;Semaphore(8) · nil if &lt;3 obs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#065F46;fontColor=#FFFFFF;strokeColor=#047857;shadow=1;fontSize=11;" vertex="1" parent="1">
