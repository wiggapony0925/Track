        <mxCell id="sec_user_bg" value="&lt;b style=&quot;font-size:13px;color:#1E40AF;&quot;&gt;📱 USER REQUEST FLOW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;dashed=1;dashPattern=8 4;verticalAlign=top;arcSize=4;" vertex="1" parent="1">
