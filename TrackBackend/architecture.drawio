        <!-- ═══════════════════════════════════════════════════ -->
        <!--  TIER 6 — ML PREDICTION SYSTEM                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="ml_tier" value="ML Prediction System  ·  3 Modules  ·  app/ml/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#00838F;dashed=1;dashPattern=8 4;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#00838F;arcSize=4;container=1;collapsible=0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1555" width="1500" height="370" as="geometry"/>
        </mxCell>

        <mxCell id="ml_delay" value="&lt;b style=&quot;font-size:12px;&quot;&gt;delay_model.py&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4DD0E1;&quot;&gt;&lt;font style=&quot;font-size:9px;color:#B2EBF2;&quot;&gt;&lt;b&gt;LightGBM · 176 trees · 1,133 KB&lt;/b&gt;&lt;br&gt;MAE 0.92 min · 2.86 M samples&lt;br&gt;8 features: hour, dow, rush, rain,&lt;br&gt;congestion, otp, recency, line&lt;br&gt;CBTC-aware heuristic (L / 7 lines)&lt;br&gt;Fallback: pure heuristic if pkl missing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006064;fontColor=#FFFFFF;strokeColor=#00838F;arcSize=10;shadow=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="ml_tier">
          <mxGeometry x="20" y="35" width="290" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="ml_recency" value="&lt;b style=&quot;font-size:12px;&quot;&gt;recency_model.py&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4DD0E1;&quot;&gt;&lt;font style=&quot;font-size:9px;color:#B2EBF2;&quot;&gt;Redis ZSET · EWMA weighting&lt;br&gt;Key: track:delay:factor:{route}:{stop}&lt;br&gt;Semaphore(8) on reads&lt;br&gt;observe_siri_delays_batch() → 1 pipeline&lt;br&gt;bus_client fires batch after each loop&lt;br&gt;TTL: 1800s · α = 0.4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006064;fontColor=#FFFFFF;strokeColor=#00838F;arcSize=10;shadow=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="ml_tier">
          <mxGeometry x="330" y="35" width="290" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="ml_train" value="&lt;b style=&quot;font-size:12px;&quot;&gt;train_model.py&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4DD0E1;&quot;&gt;&lt;font style=&quot;font-size:9px;color:#B2EBF2;&quot;&gt;&lt;i&gt;Offline only — not deployed on Render&lt;/i&gt;&lt;br&gt;3-phase: download → train → evaluate&lt;br&gt;30 datasets · LightGBM 300 rounds&lt;br&gt;Outputs: app/data/delay_model.pkl&lt;br&gt;Metric log: app/data/model_metrics.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00695C;fontColor=#FFFFFF;strokeColor=#00838F;arcSize=10;shadow=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=2;" vertex="1" parent="ml_tier">
          <mxGeometry x="645" y="35" width="270" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="ml_pkl" value="&lt;b style=&quot;font-size:12px;&quot;&gt;delay_model.pkl&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4DD0E1;&quot;&gt;&lt;font style=&quot;font-size:9px;color:#B2EBF2;&quot;&gt;app/data/ · 1,133 KB&lt;br&gt;Loaded at startup via joblib&lt;br&gt;Docker-bundled (trained offline)&lt;/font&gt;" style="shape=mxgraph.flowchart.stored_data;whiteSpace=wrap;html=1;fillColor=#004D40;fontColor=#FFFFFF;strokeColor=#00796B;shadow=1;" vertex="1" parent="ml_tier">
