# Logs
TrackBackend/logs/

# Runtime caches (generated at startup, not source-controlled)
TrackBackend/app/data/_cache_*

# GTFS metadata (local download/freshness tracking)
TrackBackend/app/data/.dl_meta/
TrackBackend/app/data/.gtfs_meta/

# Temp DB files
*.db.tmp
*.db-wal
*.db-shm

# Diagnostic scripts (local dev only)
TrackBackend/scripts/diag_*.py

# Supabase CLI temp files
supabase/.temp/
