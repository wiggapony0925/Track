TrackBackend/app/data/training/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Large Data Files
*.db
TrackBackend/app/data/subway/supplemented_GTFS/
TrackBackend/app/data/bus/
