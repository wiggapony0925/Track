*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
.env

# Secrets & keys — NEVER commit these
*.p8
*.jwt
*.pem
*.key
Secrets.plist
*.xcconfig

# ML training data — large raw files from data.ny.gov, local dev only
